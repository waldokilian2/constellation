# Constellation configuration — AI chat (OpenAI-compatible provider).
#
# Defaults to Zen (https://opencode.ai/zen), an OpenAI-compatible gateway.
# Any OpenAI-compatible endpoint works — set OPENCODE_BASE_URL to override.
# OPENCODE_* vars are canonical; OPENAI_* are accepted as aliases.
#
# This file is committed as a TEMPLATE. Fill in your own key locally; the
# start scripts (start.sh / start.bat) mark it skip-worktree so your edits
# stay local and are never committed or pushed.
#
# Rules:
#   - Values are UNQUOTED (do not wrap in quotes).
#   - Real shell env vars take precedence over this file.
#   - Leave OPENCODE_API_KEY empty to disable AI chat gracefully.
#   - Only free models (ids ending in "-free") are selectable in the UI.

OPENCODE_API_KEY=
# Zen endpoint (already includes /v1). Leave as-is, or point elsewhere.
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=deepseek-v4-flash-free

# GitHub Boards sync (engine/boards) — via the official GitHub MCP server.
# Set a PAT (repo + read:project + project scopes) for two-way issue sync.
# Leave empty to fall back to `gh auth token` (local dev only — NOT available
# inside the Docker container).
GITHUB_PERSONAL_ACCESS_TOKEN=
# Transport: "http" (remote server, default) or "stdio" (Docker/Go binary).
GITHUB_MCP_TRANSPORT=http
# Remote GitHub MCP server (streamable HTTP). Used when transport=http.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# Stdio launch (transport=stdio): command + args. Docker example:
GITHUB_MCP_COMMAND=docker
GITHUB_MCP_ARGS=run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server
# Which GitHub MCP toolsets the board provider enables (issues + projects).
GITHUB_MCP_TOOLSETS=issues,projects
# MCP read/write timeout (seconds) — slow GraphQL calls / card moves get headroom.
GITHUB_MCP_TIMEOUT=120
# MCP TCP connect timeout (seconds) — fail fast when the remote is unreachable.
GITHUB_MCP_CONNECT_TIMEOUT=10
