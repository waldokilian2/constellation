# Constellation configuration — AI chat (OpenAI-compatible provider).
#
# This file is committed as a TEMPLATE. Fill in your own values locally;
# the start scripts (start.sh / start.bat) mark it skip-worktree so your
# edits stay local and are never committed or pushed.
#
# Rules:
#   - Values are UNQUOTED (do not wrap in quotes).
#   - Real shell env vars take precedence over this file.
#   - Leave OPENAI_API_KEY empty to disable AI chat gracefully.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
