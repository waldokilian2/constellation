{
  "name": "constellation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "esbuild web/src/main.jsx --bundle --format=esm --platform=node --jsx=automatic --loader:.css=empty --loader:.png=dataurl --outfile=node_modules/.esbuild-check.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^12.0.2",
    "mermaid": "^11.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
